"""
사용자, 게시글 등의 식별자에 사용하는 Long 타입
"""
scalar Long

"""
날짜와 시간을 RFC3339 형식으로 표현하는 타입
예: 2026-09-30T03:10:00+09:00
"""
scalar DateTime @specifiedBy(url: "https://tools.ietf.org/html/rfc3339")


# =========================================================
# Query
# 서버의 데이터를 조회할 때 사용하는 API
# REST API의 GET과 비슷한 역할을 한다.
# =========================================================

type Query {

    """
    특정 사용자가 작성한 게시글 목록을 조회한다.

    userId: 게시글 작성자의 사용자 ID
    """
    getArticles(userId: Long!): [ArticleResponse]

    """
    특정 게시글 하나를 조회한다.

    articleId: 조회할 게시글 ID
    """
    getArticle(articleId: Long!): ArticleResponse

    """
    특정 사용자가 팔로우하고 있는 사용자들의 게시글을 조회한다.

    followerId: 피드를 조회할 사용자 ID
    """
    getFeedList(followerId: Long!): [ArticleResponse]

    """
    특정 사용자의 팔로우 목록을 조회한다.

    followerId: 팔로우 목록을 조회할 사용자 ID
    """
    getFollowList(followerId: Long!): [FollowResponse]

    """
    전체 사용자 목록을 조회한다.
    """
    getUsers: [UserResponse]

    """
    사용자 ID로 특정 사용자를 조회한다.

    userId: 조회할 사용자 ID
    """
    getUserById(userId: Long!): UserResponse
}


# =========================================================
# Mutation
# 서버의 데이터를 생성, 수정, 삭제할 때 사용하는 API
# REST API의 POST / PUT / DELETE와 비슷한 역할을 한다.
# =========================================================

type Mutation {

    """
    새로운 게시글을 작성한다.

    input: 게시글 생성에 필요한 데이터
    """
    createArticle(input: CreateArticleInput!): ArticleResponse

    """
    기존 게시글의 내용을 수정한다.

    input: 수정할 게시글 ID와 새로운 내용
    """
    updateArticle(input: UpdateArticleInput!): ArticleResponse

    """
    게시글을 삭제한다.

    articleId: 삭제할 게시글 ID

    반환값:
    true  - 삭제 성공
    false - 삭제 실패
    """
    deleteArticle(articleId: Long!): Boolean

    """
    다른 사용자를 팔로우한다.

    followeeId: 팔로우할 사용자의 ID
    """
    follow(followeeId: Long!): FollowResponse

    """
    팔로우를 취소한다.

    followeeId: 팔로우를 취소할 사용자의 ID
    """
    unfollow(followeeId: Long!): Boolean

    """
    새로운 사용자를 생성한다.

    input: 사용자 이름과 비밀번호
    """
    createUser(input: CreateUserInput!): UserResponse

    """
    기존 사용자 정보를 수정한다.

    input: 사용자 ID와 변경할 사용자 정보
    """
    updateUser(input: UpdateUserInput!): UserResponse

    """
    사용자를 삭제한다.

    userId: 삭제할 사용자 ID
    """
    deleteUser(userId: Long!): Boolean
}


# =========================================================
# Article Input
# 게시글 생성/수정 요청에 사용하는 입력 데이터
# =========================================================

"""
게시글 생성 요청 데이터
"""
input CreateArticleInput {

    """
    작성할 게시글 내용
    """
    content: String!
}


"""
게시글 수정 요청 데이터
"""
input UpdateArticleInput {

    """
    수정할 게시글 ID
    """
    articleId: Long!

    """
    변경할 게시글 내용
    """
    content: String!
}


# =========================================================
# User Input
# 사용자 생성/수정 요청에 사용하는 입력 데이터
# =========================================================

"""
사용자 생성 요청 데이터
"""
input CreateUserInput {

    """
    사용자 로그인 이름
    """
    username: String!

    """
    사용자 비밀번호
    """
    password: String!
}


"""
사용자 수정 요청 데이터
"""
input UpdateUserInput {

    """
    수정할 사용자 ID
    """
    userId: Long!

    """
    변경할 사용자 이름
    null이면 변경하지 않는다.
    """
    username: String

    """
    변경할 비밀번호
    null이면 변경하지 않는다.
    """
    password: String
}


# =========================================================
# Response
# GraphQL API가 클라이언트에게 반환하는 데이터 구조
# =========================================================

"""
게시글 조회 결과
"""
type ArticleResponse {

    """
    게시글 ID
    """
    articleId: Long

    """
    게시글 내용
    """
    content: String

    """
    게시글 작성자의 사용자 ID
    """
    authorId: Long

    """
    게시글 작성자의 사용자 이름
    """
    authorName: String

    """
    게시글 작성 시간
    """
    createdAt: DateTime
}


"""
팔로우 관계 조회 결과
"""
type FollowResponse {

    """
    팔로우를 하는 사용자 ID
    """
    followerId: Long

    """
    팔로우 대상 사용자 ID
    """
    followeeId: Long
}


"""
사용자 조회 결과
"""
type UserResponse {

    """
    사용자 ID
    """
    id: Long

    """
    사용자 이름
    """
    username: String
}